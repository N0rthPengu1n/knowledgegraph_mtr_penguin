    mv:district:WanChai ,
    mv:district:Eastern .

md:line:tsuenwan mo:hasLocale
    mv:district:CentralWestern ,
    mv:district:ShamShuiPo ,
    mv:district:KwaiTsing ,
    mv:district:TsuenWan .

