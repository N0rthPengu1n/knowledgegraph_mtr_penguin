md:station:sheungwan
    mo:hasLivery mv:colour:Khaki .

md:station:admiralty
    mo:hasLivery mv:colour:BlueWhite .

md:station:hku
    mo:hasLivery mv:colour:MintGreen .

md:station:wanchai
    mo:hasLivery mv:colour:LimeGreen .

