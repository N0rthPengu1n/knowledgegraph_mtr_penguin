    mv:transport:Tram .

md:station:hku mo:hasConnection
    mv:transport:Bus ,
    mv:transport:MiniBus .

md:station:wanchai mo:hasConnection
    mv:transport:Bus ,
    mv:transport:MiniBus ,
    mv:transport:Tram ,
    mv:transport:Ferry .

md:station:causewaybay mo:hasConnection
    mv:transport:Bus ,
