### The Landmarks

md:landmark:lankwaifong rdf:type mo:Landmark ;
  rdfs:label "Lan Kwai Fong"@en , "兰桂坊"@zh-cn .

md:landmark:lippo rdf:type mo:Landmark ;
  rdfs:label "Lippo Centre"@en , "力宝中心"@zh-cn .

md:landmark:wingong rdf:type mo:Landmark ;
  rdfs:label "Wing On"@en , "永安公司"@zh-cn .

md:landmark:queensstreet rdf:type mo:Landmark ;
  rdfs:label "Queens Street"@en , "皇后大道"@zh-cn .

md:landmark:hkubuilding rdf:type mo:Landmark ;
  rdfs:label "the University of Hong Kong "@en , "香港大学本部"@zh-cn .

md:landmark:bluehhouse rdf:type mo:Landmark ;
  rdfs:label "Blue House"@en , "蓝屋"@zh-cn .

md:landmark:greatgeorgestreet rdf:type mo:Landmark ;
  rdfs:label "Great George Street"@en , "記利佐治街"@zh-cn .

md:landmark:kowloonparksportscentre rdf:type mo:Landmark ;
  rdfs:label "Kowloon Park Sports Centre"@en , "九龙公园体育馆"@zh-cn .


### The Train Station Exits

md:exit:central:c rdf:type mo:StationExit ;
  rdfs:label "Central Exit C"@en ;
  mo:streetExit "Li Yuen Street (East & West)"@en .

md:exit:central:d2 rdf:type mo:StationExit ;
  rdfs:label "Central Exit D2"@en ;
  mo:streetExit "Queens Road"@en ;
  mo:landmark md:landmark:lankwaifong ;
  mo:landmarkExit <https://en.wikipedia.org/wiki/Lan_Kwai_Fong> .

md:exit:sheungwan:e3 rdf:type mo:StationExit ;
  rdfs:label "Sheung Wan Exit E3"@en ;
  mo:streetExit "Des Voeux Road Central"@en ;
  mo:landmark md:landmark:wingong ;
  mo:landmarkExit <https://en.wikipedia.org/wiki/Wing_Ong> .

md:exit:admiralty:b rdf:type mo:StationExit ;
  rdfs:label "Admiralty Exit B"@en ;
  mo:streetExit "Drake Street"@en ;
  mo:landmark md:landmark:lippo ;
  mo:landmarkExit <https://en.wikipedia.org/wiki/Lippo_Centre_(Hong_Kong)> .

md:exit:saiyingpun:a rdf:type mo:StationExit ;
  rdfs:label "Sai Ying Pun Exit A"@en ;
  mo:streetExit "High Street"@en ;
  mo:landmark md:landmark:queensstreet;
  mo:landmarkExit <https://zh.wikipedia.org/wiki/皇后大道_(香港)> .

# Exit for HKU
md:exit:hku:a2 rdf:type mo:StationExit ;
  rdfs:label "HKU Exit A2"@en ;
  mo:streetExit "Pok Fu Lam Road"@en ;
  mo:landmark md:landmark:hkubuilding;
  mo:landmarkExit <https://zh.wikipedia.org/wiki/香港大學本部大樓> .

# Exit for Wan Chai
md:exit:wanchai:a3 rdf:type mo:StationExit ;
  rdfs:label "Wan Chai Exit A3"@en ;
  mo:streetExit "Hennessy Road"@en ;
  mo:landmark md:landmark:bluehhouse ;
  mo:landmarkExit <https://zh.wikipedia.org/wiki/藍屋> .

# Exit for Causeway Bay
md:exit:causewaybay:f rdf:type mo:StationExit ;
  rdfs:label "Causeway Bay Exit F"@en ;
  mo:streetExit "Great George Street"@en ;
  mo:landmark md:landmark:greatgeorgestreet;
  mo:landmarkExit <https://zh.wikipedia.org/wiki/記利佐治街> .

# Exit for Tsim Sha Tsui
md:exit:tsimshatsui:a1 rdf:type mo:StationExit ;
  rdfs:label "Tsim Sha Tsui Exit A1"@en ;
  mo:streetExit "Salisbury Road"@en ;
  mo:landmark md:landmark:kowloonparksportscentre;
  mo:landmarkExit <https://zh.wikipedia.org/wiki/九龍公園體育館> .

### ----->>> Add NEW Train Station Exits here  <<<----- ###



### The Train Services

md:service:island:central rdf:type mo:TrainService ;
  rdfs:label "Island - Central Service"@en ;
  mo:runsOnTrainLine md:line:island ;
  mo:hasTrainStation md:station:central ;
  mo:hasPrecedingStation md:station:sheungwan ;
  mo:platformPreceding "4"^^xsd:string ;
  mo:hasFollowingStation md:station:admiralty ;
  mo:platformFollowing "3"^^xsd:string .

md:service:island:sheungwan rdf:type mo:TrainService ;
  rdfs:label "Island - Sheung Wan Service"@en ;
  mo:runsOnTrainLine md:line:island ;
  mo:hasTrainStation md:station:sheungwan ;
  mo:hasPrecedingStation md:station:saiyingpun ;
  mo:platformPreceding "1"^^xsd:string ;
  mo:hasFollowingStation md:station:central ;
  mo:platformFollowing "2"^^xsd:string .

md:service:tsuenwan:central rdf:type mo:TrainService ;
  rdfs:label "Tsuen Wan - Central Service"@en ;
  mo:runsOnTrainLine md:line:tsuenwan ;
  mo:hasTerminusStation md:station:central ;
  mo:hasFollowingStation md:station:admiralty ;
  mo:platformFollowing "1"^^xsd:string, "2"^^xsd:string .

md:service:tsuenwan:admiralty rdf:type mo:TrainService ;
  rdfs:label "Tsuen Wan - Admiralty Service"@en ;
  mo:runsOnTrainLine md:line:tsuenwan ;
  mo:hasTrainStation md:station:admiralty ;
  mo:hasPrecedingStation md:station:central ;
  mo:platformPreceding "4"^^xsd:string ;
  mo:hasFollowingStation md:station:tsimshatsui ;
  mo:platformFollowing "1"^^xsd:string .

md:service:island:saiyingpun rdf:type mo:TrainService ;
  rdfs:label "Island - Sai Ying Pun Service"@en ;
  mo:runsOnTrainLine md:line:island ;
  mo:hasTrainStation md:station:saiyingpun ;
  mo:hasPrecedingStation md:station:sheungwan ;
  mo:platformPreceding "2"^^xsd:string ;
  mo:hasFollowingStation md:station:hku ;
  mo:platformFollowing "1"^^xsd:string .

md:service:island:admiralty rdf:type mo:TrainService ;
  rdfs:label "Island - Admiralty Service"@en ;
  mo:runsOnTrainLine md:line:island ;
  mo:hasTrainStation md:station:admiralty ;
  mo:hasPrecedingStation md:station:central ;
  mo:platformPreceding "3"^^xsd:string ;
  mo:hasFollowingStation md:station:wanchai ;
  mo:platformFollowing "2"^^xsd:string .

md:service:island:wanchai rdf:type mo:TrainService ;
  rdfs:label "Island - Wan Chai Service"@en ;
  mo:runsOnTrainLine md:line:island ;
  mo:hasTrainStation md:station:wanchai ;
  mo:hasPrecedingStation md:station:admiralty ;
  mo:platformPreceding "1"^^xsd:string ;
  mo:hasFollowingStation md:station:causewaybay ;
  mo:platformFollowing "2"^^xsd:string .

### ----->>> Add NEW Train Services here  <<<----- ###


