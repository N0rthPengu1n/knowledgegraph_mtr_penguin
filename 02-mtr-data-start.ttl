@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix md: <http://data.mtr.hk/> .
@prefix mo: <http://onto.mtr.hk/> .
@prefix mv: <http://vocab.mtr.hk/> .
@prefix ms: <http://shape.mtr.hk/> .


### The Train Lines

md:line:island rdf:type mo:TrainLine;
  rdfs:label "Island Train Line"@en, "港岛线"@zh-cn ;
  mo:lineColour "#0075C9"@en .

md:line:tsuenwan rdf:type mo:TrainLine;
  rdfs:label "Tsuen Wan Train Line"@en, "荃湾线"@zh-cn ;
  mo:lineColour "#c90000"@en .


### The Train Stations

md:station:central rdf:type mo:TrainStation ;
  rdfs:label "Central Station"@en, "中环"@zh-cn;
  mo:hasStationExit md:exit:central:c, md:exit:central:d2 ;
  mo:lineColour "#0075C9"@en .

md:station:sheungwan rdf:type mo:TrainStation ;
  rdfs:label "Sheung Wan Station "@en ;
  mo:hasStationExit md:exit:sheungwan:e3 ;
  mo:lineColour "#0075C9"@en .

md:station:admiralty rdf:type mo:TrainStation ;
  rdfs:label "Admiralty Station"@en ;
  mo:hasStationExit md:exit:admiralty:b ;
  mo:lineColour "#0075C9"@en .

md:station:saiyingpun rdf:type mo:TrainStation ;
  rdfs:label "Sai Ying Pun Station"@en, "西营盘站"@zh-cn ;
  mo:hasStationExit md:exit:saiyingpun:a ;
  mo:lineColour "#0075C9"@en .

md:station:hku rdf:type mo:TrainStation ;
  rdfs:label "HKU Station"@en, "香港大学站"@zh-cn ;
  mo:hasStationExit md:exit:hku:a2 ;
  mo:lineColour "#0075C9"@en .

md:station:wanchai rdf:type mo:TrainStation ;
  rdfs:label "Wan Chai Station"@en, "湾仔站"@zh-cn ;
  mo:hasStationExit md:exit:wanchai:a3 ;
  mo:lineColour "#0075C9"@en .

md:station:causewaybay rdf:type mo:TrainStation ;
  rdfs:label "Causeway Bay Station"@en, "铜锣湾站"@zh-cn ;
  mo:hasStationExit md:exit:causewaybay:f ;
  mo:lineColour "#0075C9"@en .

md:station:tsimshatsui rdf:type mo:TrainStation ;
  rdfs:label "Tsim Sha Tsui Station"@en, "尖沙咀站"@zh-cn ;
  mo:hasStationExit md:exit:tsimshatsui:a1 ;
  mo:lineColour "#c90000"@en .

